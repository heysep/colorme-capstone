version: '3.8'

services:
  db:
    image: bitnamilegacy/mariadb:11.4.4 # ✅ Galera 아닌 일반 MariaDB
    container_name: drvalue_bmes_db
    environment:
      - MARIADB_ROOT_USER=${MARIADB_ROOT_USER}
      - MARIADB_ROOT_PASSWORD=${MARIADB_ROOT_PASSWORD}
      - MARIADB_USER=${MARIADB_USER}
      - MARIADB_PASSWORD=${MARIADB_PASSWORD}
      - MARIADB_DATABASE=${MARIADB_DATABASE}
      - MARIADB_ENABLE_SLOW_QUERY=1
      - MARIADB_LONG_QUERY_TIME=5.0
      - MARIADB_EXTRA_FLAGS=--wait_timeout=3600 --interactive_timeout=3600 --net_read_timeout=60 --net_write_timeout=60 --innodb_buffer_pool_size=2G --query_cache_size=256M --innodb_flush_method=O_DIRECT --auto_increment_increment=1 --auto_increment_offset=1
    ports:
      - '3306:3306'
    healthcheck:
      test:
        [
          'CMD-SHELL',
          '/opt/bitnami/mariadb/bin/mysql -h127.0.0.1 -u"$MARIADB_ROOT_USER" -p"$MARIADB_ROOT_PASSWORD" -e "SELECT 1"',
        ]
      interval: 10s
      timeout: 5s
      retries: 30
      start_period: 30s
    volumes:
      - ./data_mnt_db:/bitnami/mariadb
    networks:
      - drvalue_bmes_backend_net

  logdb:
    image: bitnamilegacy/mariadb:11.4.4
    container_name: drvalue_bmes_logdb
    environment:
      - MARIADB_ROOT_USER=${MARIADB_ROOT_USER}
      - MARIADB_ROOT_PASSWORD=${MARIADB_ROOT_PASSWORD}
      - MARIADB_ENABLE_SLOW_QUERY=1
      - MARIADB_LONG_QUERY_TIME=2.0
      - MARIADB_EXTRA_FLAGS=--innodb_flush_log_at_trx_commit=2 --sync_binlog=0 --skip-log-bin --innodb_flush_method=O_DIRECT --innodb_log_file_size=2G --innodb_log_buffer_size=64M --innodb_buffer_pool_size=2G --table_open_cache=4096 --open_files_limit=65535 --max_connections=600 --wait_timeout=3600 --interactive_timeout=3600 --net_read_timeout=60 --net_write_timeout=60
    healthcheck:
      test:
        [
          'CMD-SHELL',
          '/opt/bitnami/mariadb/bin/mysql -h127.0.0.1 -u"$MARIADB_ROOT_USER" -p"$MARIADB_ROOT_PASSWORD" -Nse "SELECT 1" >/dev/null 2>&1',
        ]
      interval: 10s
      timeout: 5s
      retries: 30
      start_period: 20s
    ports:
      - '3315:3306'
    volumes:
      - ./data_mnt_logdb:/bitnami/mariadb
      - ./initdb-logdb:/docker-entrypoint-initdb.d:ro
    networks:
      - drvalue_bmes_backend_net

networks:
  drvalue_bmes_backend_net:
    external: true
